<!DOCTYPE html>
<html>
  <head>
    <title>Items</title>
  </head>
  <body>
    <h1>All Items</h1>

    <form method="GET" action="/items" style="margin-bottom: 1rem">
      <input
        type="text"
        name="search"
        value="<%= typeof search !== 'undefined' ? search : '' %>"
        placeholder="Search by name or brand"
      />
      <button type="submit">Search</button>
      <a href="/items">Reset</a>
    </form>

    <a href="/items/new">+ Add Item</a>

    <ul>
      <% items.forEach(item => { %>
      <li>
        <strong><%= item.name %></strong> (<%= item.brand %>) - <%=
        item.condition %>, <%= item.availability %> [Category: <%=
        item.category_name %>] | <a href="/items/<%= item.id %>/edit">Edit</a> |
        <form
          action="/items/<%= item.id %>/delete"
          method="POST"
          style="display: inline"
        >
          <button type="submit" onclick="return confirm('Delete this item?')">
            🗑 Delete
          </button>
        </form>
        | <a href="/maintenance/<%= item.id %>">🛠 Maintenance Logs</a> |
        <a href="/bookings/new?item_id=<%= item.id %>">Reserve</a>
      </li>
      <% }) %> <% if (items.length === 0) { %>
      <li>No items found.</li>
      <% } %>
    </ul>
  </body>
</html>
