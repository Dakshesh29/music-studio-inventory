<!DOCTYPE html>
<html>
<head>
  <title>Edit Booking</title>
  <link rel="stylesheet" href="/css/styles.css">
</head>
<body>
  <%- include("../partials/header") %>

  <h1>Edit Booking</h1>

  <form class="form" action="/bookings/<%= booking.id %>/edit" method="POST">
    <label>Instrument</label>
    <select name="item_id" required>
      <% items.forEach(i => { %>
        <option value="<%= i.id %>" <%= (i.id === booking.item_id) ? 'selected' : '' %>><%= i.name %></option>
      <% }) %>
    </select>

    <label>User Name</label>
    <input type="text" name="user_name" value="<%= booking.user_name %>" required/>

    <label>Start Time</label>
    <input type="datetime-local" name="start_time" value="<%= new Date(booking.start_time).toISOString().slice(0,16) %>" required/>

    <label>End Time</label>
    <input type="datetime-local" name="end_time" value="<%= new Date(booking.end_time).toISOString().slice(0,16) %>" required/>

    <label>Status</label>
    <select name="status" required>
      <% ['Reserved','Active','Completed','Cancelled'].forEach(s => { %>
        <option value="<%= s %>" <%= booking.status === s ? 'selected' : '' %>><%= s %></option>
      <% }) %>
    </select>

    <button class="btn" type="submit">Update</button>
  </form>
</body>
</html>
