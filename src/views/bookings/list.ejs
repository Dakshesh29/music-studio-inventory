<!DOCTYPE html>
<html>
  <head>
    <title>Bookings</title>
  </head>
  <body>
    <h1>All Bookings</h1>
    <a href="/bookings/new">+ New Booking</a>
    <ul>
      <% bookings.forEach(b => { %>
      <li>
        <strong><%= b.item_name %></strong> — <%= b.user_name %>
        <br />
        <small>
          <%= new Date(b.start_time).toLocaleString() %> → <%= new
          Date(b.end_time).toLocaleString() %>
        </small>
        <br />
        Status: <%= b.status %> |
        <a href="/bookings/<%= b.id %>/edit">Edit</a>
        |
        <form
          action="/bookings/<%= b.id %>/delete"
          method="POST"
          style="display: inline"
        >
          <button
            type="submit"
            onclick="return confirm('Cancel this booking?')"
          >
            Delete
          </button>
        </form>
      </li>
      <% }) %>
    </ul>
  </body>
</html>
